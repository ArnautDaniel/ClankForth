# The library's own Forth (lib/*.fs) as C strings: forth_builtin_sources, for forth.c's built-in vocabularies.
# Run at configure time; the sources are configure dependencies, so a change to one reconfigures.
function(clankforth_embed out)
    set(body "/* made by cmake/embed.cmake from the .fs files in lib/ - not to be edited */\n#include <stddef.h>\n\n")
    set(table "")
    set(k 0)
    foreach(src ${ARGN})
        get_filename_component(name "${src}" NAME_WE)
        file(READ "${src}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND body "static const char source${k}[] = {${bytes}0};\n")
        string(APPEND table "    {\"${name}\", source${k}},\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${src}")
        math(EXPR k "${k} + 1")
    endforeach()
    string(APPEND body "\ntypedef struct ForthSource {\n    const char *name;\n    const char *text;\n} ForthSource;\n")
    string(APPEND body "extern const ForthSource forth_builtin_sources[];\nconst ForthSource forth_builtin_sources[] = {\n${table}    {NULL, NULL},\n};\n")
    file(WRITE "${out}" "${body}")
endfunction()
