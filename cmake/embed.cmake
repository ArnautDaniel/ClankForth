# The library's own Forth as C strings: forth_builtin_sources, for forth.c's built-in vocabularies.
#   core/<name>.fs                 the language's own (the prelude): vocabulary <name>
#   basis/<a>/<a>.fs               a library: vocabulary a
#   basis/<a>/<b>/<b>.fs           one within it: vocabulary a.b (and so on down)
# Run at configure time; the sources are configure dependencies, so a change to one (or a new one) reconfigures.
function(clankforth_embed out core_dir basis_dir)
    set(body "/* made by cmake/embed.cmake from core/ and basis/ - not to be edited */\n#include <stddef.h>\n\n")
    set(table "")
    set(k 0)
    file(GLOB core_files CONFIGURE_DEPENDS "${core_dir}/*.fs")
    file(GLOB_RECURSE basis_files CONFIGURE_DEPENDS RELATIVE "${basis_dir}" "${basis_dir}/*.fs")
    list(SORT core_files)
    list(SORT basis_files)
    set(entries "")
    foreach(src ${core_files})
        get_filename_component(name "${src}" NAME_WE)
        list(APPEND entries "${name}|${src}")
    endforeach()
    foreach(rel ${basis_files})
        get_filename_component(dir "${rel}" DIRECTORY)
        get_filename_component(file "${rel}" NAME_WE)
        get_filename_component(last "${dir}" NAME)
        if(NOT dir OR NOT last STREQUAL file)
            message(FATAL_ERROR "basis/${rel}: a vocabulary's file is named after its folder (basis/a/b/b.fs is a.b)")
        endif()
        string(REPLACE "/" "." name "${dir}")
        list(APPEND entries "${name}|${basis_dir}/${rel}")
    endforeach()
    foreach(entry ${entries})
        string(FIND "${entry}" "|" bar)
        string(SUBSTRING "${entry}" 0 ${bar} name)
        math(EXPR from "${bar} + 1")
        string(SUBSTRING "${entry}" ${from} -1 src)
        file(READ "${src}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND body "static const char source${k}[] = {${bytes}0};\n")
        string(APPEND table "    {\"${name}\", source${k}},\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${src}")
        math(EXPR k "${k} + 1")
    endforeach()
    string(APPEND body "\ntypedef struct ForthSource {\n    const char *name;\n    const char *text;\n} ForthSource;\n")
    string(APPEND body "extern const ForthSource forth_builtin_sources[];\nconst ForthSource forth_builtin_sources[] = {\n${table}    {NULL, NULL},\n};\n")
    file(WRITE "${out}" "${body}")
endfunction()
